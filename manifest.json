{
  "manifest_version": 3,
  "name": "Crest Take",
  "version": "3.0.0",
  "description": "Download the best progressive MP4 from a video post on X.",
  "minimum_chrome_version": "120",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://abs.twimg.com/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "Crest Take",
  "icons": {
    "128": "icon128.png"
  }
}
