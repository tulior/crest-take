{
  "manifest_version": 3,
  "name": "Crest Take",
  "short_name": "Crest Take",
  "version": "1.0.0",
  "description": "Save the highest-bitrate MP4 from a video post with one click. Runs on x.com, keeps nothing, uploads nothing.",
  "icons": { "128": "icon128.png" },
  "permissions": ["downloads"],
  "background": {
    "service_worker": "crest-take.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["crest-take.js"],
      "run_at": "document_idle"
    }
  ]
}
